# GOAT environment. Everything is optional for local work: without Supabase the
# demo list (/l/demo) and the fixture AI provider still run.

# --- Supabase (schema goat_v2) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server only. Read in src/v2/ai/server.ts; bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Site ---
# Absolute origin for share links, social cards, embeds and oEmbed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI ---
# Unset ANTHROPIC_API_KEY (and no V2_AI_PROVIDER) uses the free fixture provider.
ANTHROPIC_API_KEY=
# fixture | cli | claude. Overrides the key-based choice. `cli` runs the local
# Claude Code CLI (`claude -p`, haiku, low effort) so tests need no API key;
# development only. Tune with V2_CLI_MODEL, V2_CLI_EFFORT, V2_CLAUDE_BIN.
V2_AI_PROVIDER=
